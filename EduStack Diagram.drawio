        <mxCell id="nRdzSMOLoNk7nJ2nSQWL-6" value="&lt;h1 align=&quot;center&quot; style=&quot;margin-top: 0px;&quot;&gt;EduStock Roles&lt;br&gt;&lt;/h1&gt;&lt;p&gt;EduStock adalah sistem informasi penyimpanan dan pengelolaan barang/inventaris di Universitas Sugeng Hartono berbasis web.&lt;/p&gt;&lt;p&gt;Terdapat 3 role dengan masing-masing jobdesk,&lt;/p&gt;&lt;p&gt;- Admin&lt;/p&gt;&lt;p&gt;- Receiver&lt;/p&gt;&lt;p&gt;- User&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" parent="nRdzSMOLoNk7nJ2nSQWL-80" vertex="1">
